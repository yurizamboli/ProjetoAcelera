<Window x:Class="ProjetoAcelera.Views.Obras.TelaAdicionarObra"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adicionar Obra"
        Height="961"
        Width="848"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow">
        <Window.Resources>

    <Style x:Key="BotaoObraStyle"
           TargetType="Button">

        <Setter Property="Foreground"
                Value="White"/>

        <Setter Property="FontWeight"
                Value="Bold"/>

        <Setter Property="BorderThickness"
                Value="0"/>

        <Setter Property="Cursor"
                Value="Hand"/>

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="Button">

                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="10">

                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>

                    </Border>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>

</Window.Resources>
    <!-- FUNDO -->
    <Window.Background>
        <ImageBrush ImageSource="/ImagemAcelera/solid-navy-blue-concrete-textured-wall.jpg"
                    Stretch="UniformToFill"/>
    </Window.Background>

    <Grid Margin="0,0,0,-6">

        <!-- CARD PRINCIPAL -->
        <Border Background="#F3E6C9"
                Margin="28"
                Padding="28"
                CornerRadius="22"
                BorderBrush="#C9B27D"
                BorderThickness="2">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <!-- TOPO -->
                    <StackPanel Margin="0,0,0,22">

                        <TextBlock Text="Adicionar Nova Obra"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   FontFamily="Georgia"
                                   Foreground="#1F3A5F"/>

                        <TextBlock Text="Compartilhe uma obra artística com a comunidade."
                                   FontSize="14"
                                   Foreground="#7A6A4A"
                                   Margin="0,6,0,0"/>

                    </StackPanel>

                    <!-- TÍTULO -->
                    <TextBlock Text="Título da Obra"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="#1F3A5F"
                               Margin="0,0,0,6"/>

                    <Border Background="#FFF7E1"
                            BorderBrush="#C9B27D"
                            BorderThickness="1.5"
                            CornerRadius="12"
                            Margin="0,0,0,16">

                        <Grid>

                            <TextBox x:Name="txtTitulo"
                                     Height="42"
                                     FontSize="14"
                                     Padding="12,0"
                                     VerticalContentAlignment="Center"
                                     Foreground="#1F3A5F"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     GotFocus="TxtTitulo_GotFocus"
                                     LostFocus="TxtTitulo_LostFocus"
                                     TextChanged="txtTitulo_TextChanged"/>

                            <TextBlock x:Name="txtTituloPlaceholder"
                                       Text="Digite o título da obra"
                                       Foreground="#888888"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>

                        </Grid>

                    </Border>

                    <!-- DESCRIÇÃO -->
                    <TextBlock Text="Descrição"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="#1F3A5F"
                               Margin="0,0,0,6"/>

                    <Border Background="#FFF7E1"
                            BorderBrush="#C9B27D"
                            BorderThickness="1.5"
                            CornerRadius="12"
                            Margin="0,0,0,18">

                        <Grid>

                            <TextBox x:Name="txtDescricao"
                                     Height="120"
                                     FontSize="14"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Padding="12"
                                     Foreground="#333333"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     GotFocus="TxtDescricao_GotFocus"
                                     LostFocus="TxtDescricao_LostFocus"
                                     TextChanged="txtDescricao_TextChanged"
                                     MaxLength="250"/>

                            <TextBlock x:Name="txtDescricaoPlaceholder"
                                       Text="Descreva a obra, inspiração, significado..."
                                       Foreground="#888888"
                                       Margin="14,12,0,0"
                                       VerticalAlignment="Top"
                                       IsHitTestVisible="False"/>

                        </Grid>

                    </Border>

                    <!-- PREVIEW -->
                    <TextBlock Text="Imagem da Obra"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="#1F3A5F"
                               Margin="0,0,0,8"/>

                    <Border Height="320"
                            Background="#E8E1CF"
                            CornerRadius="0"
                            BorderBrush="#C9B27D"
                            BorderThickness="2"
                            ClipToBounds="True"
                            Margin="0,0,0,16">

                        <Grid>

                            <Image x:Name="imgPreview"
                                   Stretch="Fill"/>

                            <!-- PLACEHOLDER -->
                            <StackPanel x:Name="placeholderImagem"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center">

                                <TextBlock Text="Nenhuma imagem selecionada"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#666666"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="A pré-visualização aparecerá aqui"
                                           FontSize="12"
                                           Foreground="#888888"
                                           Margin="0,4,0,0"
                                           HorizontalAlignment="Center"/>

                            </StackPanel>

                        </Grid>

                    </Border>

                    <!-- BOTÃO IMAGEM -->
                    <Button Content="Selecionar Imagem"
                            Height="42"
                            FontSize="14"
                            Background="#1F3A5F"
                            Foreground="#F3E6C9"
                            Margin="0,0,0,20"
                            Style="{StaticResource BotaoObraStyle}"
                            Click="BtnSelecionarImagem_Click"/>

                    <!-- BOTÕES -->
                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                     <Button Grid.Column="0"
                            Content="Cancelar"
                            Height="44"
                            Margin="0,0,10,0"
                            Background="#8B1E1E"
                            Style="{StaticResource BotaoObraStyle}"
                            Click="Button_Click"/>

                    <Button Grid.Column="1"
                            Content="Salvar Obra"
                            Height="44"
                            Margin="10,0,0,0"
                            Background="#B8860B"
                            Style="{StaticResource BotaoObraStyle}"
                            Click="BtnSalvar_Click"/>

                    </Grid>

                </StackPanel>

            </ScrollViewer>

        </Border>

    </Grid>

</Window>