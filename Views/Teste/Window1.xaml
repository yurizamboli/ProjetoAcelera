<Page x:Class="ProjetoAcelera.Views.Teste.Dashboard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid>

        <ScrollViewer VerticalScrollBarVisibility="Hidden">

            <!-- CONTAINER -->
            <Grid HorizontalAlignment="Center"
                  MaxWidth="1450">

                <StackPanel Margin="0,0,0,40">

                    <!-- HERO -->
                    <Grid Height="650"
                          Margin="25,0">

                        <Border CornerRadius="0,0,28,28"
                                ClipToBounds="True">

                            <Grid>

                                <Image Source="/ImagemAcelera/cruzeiro.png"
                                       Stretch="Fill"/>

                                <!-- overlay -->
                                <Border Background="#70000000"/>

                                <!-- texto -->
                                <StackPanel VerticalAlignment="Center"
                                            HorizontalAlignment="Center">

                                    <TextBlock Text="CRUZEIRO"
                                               FontSize="72"
                                               FontWeight="Bold"
                                               FontFamily="Georgia"
                                               Foreground="#F3E6C9"
                                               HorizontalAlignment="Center"/>

                                    <Rectangle Width="150"
                                               Height="2"
                                               Fill="#D4AF37"
                                               Margin="0,18"/>

                                    <TextBlock Text="História, cultura e patrimônio do Vale do Paraíba"
                                               FontSize="24"
                                               Foreground="#F3E6C9"
                                               HorizontalAlignment="Center"/>

                                </StackPanel>

                            </Grid>

                        </Border>

                    </Grid>

                    <!-- INTRO -->
                    <Border Background="#0D3348"
                            CornerRadius="22"
                            Margin="45,-55,45,25"
                            Padding="35"
                            BorderBrush="#B8860B"
                            BorderThickness="2">

                        <StackPanel>

                            <TextBlock Text="HISTÓRIA DE CRUZEIRO"
                                       FontSize="34"
                                       FontWeight="Bold"
                                       Foreground="#F3E6C9"
                                       Margin="0,0,0,18"/>

                            <Rectangle Height="2"
                                       Fill="#D4AF37"
                                       Width="160"
                                       HorizontalAlignment="Left"
                                       Margin="0,0,0,20"/>

                            <TextBlock TextWrapping="Wrap"
                                       FontSize="17"
                                       Foreground="#F1F1F1"
                                       LineHeight="32"
                                       Text="A história de Cruzeiro começa no século XVIII, quando a região era utilizada como rota pelos tropeiros que transportavam mercadorias entre o interior de São Paulo e o litoral. Especialmente em direção a Paraty. Nesse período, o local era apenas um ponto de passagem, mas já possuía importância estratégica para o desenvolvimento regional."/>

                        </StackPanel>

                    </Border>

                    <!-- ESTAÇÃO -->
                    <Border Background="#F3E6C9"
                            CornerRadius="24"
                            Margin="45,12"
                            Padding="24"
                            BorderBrush="#C9B27D"
                            BorderThickness="2">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="420"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- imagem -->
                            <Border CornerRadius="18"
                                    ClipToBounds="True"
                                    Margin="0,0,25,0">

                                <Image Source="/ImagemAcelera/estacao.png"
                                       Height="300"
                                       Stretch="UniformToFill"/>

                            </Border>

                            <!-- texto -->
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        MaxWidth="720">

                                <TextBlock Text="ESTAÇÃO FERROVIÁRIA"
                                           FontSize="32"
                                           FontWeight="Bold"
                                           Foreground="#1F3A5F"
                                           Margin="0,0,0,12"/>

                                <Rectangle Height="2"
                                           Fill="#B8860B"
                                           Width="140"
                                           HorizontalAlignment="Left"
                                           Margin="0,0,0,18"/>

                                <TextBlock TextWrapping="Wrap"
                                           FontSize="16"
                                           Foreground="#444444"
                                           LineHeight="30"
                                           Text="Inaugurada no final do século XIX, foi um importante entroncamento ferroviário que ligava o Vale do Paraíba às ferrovias de Minas Gerais e Rio de Janeiro, desempenhando papel fundamental no transporte de café e passageiros. Atualmente, integra o patrimônio histórico e cultural da cidade."/>

                            </StackPanel>

                        </Grid>

                    </Border>

                    <!-- ROTUNDA -->
                    <Border Background="#0D3348"
                            CornerRadius="24"
                            Margin="45,12"
                            Padding="24"
                            BorderBrush="#B8860B"
                            BorderThickness="2">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="420"/>
                            </Grid.ColumnDefinitions>

                            <!-- texto -->
                            <StackPanel VerticalAlignment="Center"
                                        Margin="0,0,25,0"
                                        MaxWidth="720">

                                <TextBlock Text="ROTUNDA DE CRUZEIRO"
                                           FontSize="32"
                                           FontWeight="Bold"
                                           Foreground="#F3E6C9"
                                           Margin="0,0,0,12"/>

                                <Rectangle Height="2"
                                           Fill="#D4AF37"
                                           Width="140"
                                           HorizontalAlignment="Left"
                                           Margin="0,0,0,18"/>

                                <TextBlock TextWrapping="Wrap"
                                           FontSize="16"
                                           Foreground="#F1F1F1"
                                           LineHeight="30"
                                           Text="Construída no século XX, a Rotunda foi essencial para o funcionamento da malha ferroviária da região. Sua estrutura circular permitia o direcionamento e manutenção de locomotivas, tornando-se um dos maiores símbolos ferroviários de Cruzeiro."/>

                            </StackPanel>

                            <!-- imagem -->
                            <Border Grid.Column="1"
                                    CornerRadius="18"
                                    ClipToBounds="True">

                                <Image Source="/ImagemAcelera/rotunda.png"
                                       Height="300"
                                       Stretch="UniformToFill"/>

                            </Border>

                        </Grid>

                    </Border>

                    <!-- MUSEU -->
                    <Border Background="#F3E6C9"
                            CornerRadius="24"
                            Margin="45,12"
                            Padding="24"
                            BorderBrush="#C9B27D"
                            BorderThickness="2">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="420"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- imagem -->
                            <Border CornerRadius="18"
                                    ClipToBounds="True"
                                    Margin="0,0,25,0">

                                <Image Source="/ImagemAcelera/museu.png"
                                       Height="300"
                                       Stretch="UniformToFill"/>

                            </Border>

                            <!-- texto -->
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        MaxWidth="720">

                                <TextBlock Text="MUSEU MAJOR NOVAES"
                                           FontSize="32"
                                           FontWeight="Bold"
                                           Foreground="#1F3A5F"
                                           Margin="0,0,0,12"/>

                                <Rectangle Height="2"
                                           Fill="#B8860B"
                                           Width="140"
                                           HorizontalAlignment="Left"
                                           Margin="0,0,0,18"/>

                                <TextBlock TextWrapping="Wrap"
                                           FontSize="16"
                                           Foreground="#444444"
                                           LineHeight="30"
                                           Text="Dedicado à preservação da memória regional, o Museu Major Novaes reúne documentos, fotografias e objetos históricos que retratam o desenvolvimento cultural e social de Cruzeiro e do Vale do Paraíba."/>

                            </StackPanel>

                        </Grid>

                    </Border>

                </StackPanel>

            </Grid>

        </ScrollViewer>

    </Grid>

</Page>