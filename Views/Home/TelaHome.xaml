<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ProjetoAcelera.Views.Home.TelaHome">
    <Page.Background>
        <ImageBrush ImageSource="/ImagemAcelera/solid-navy-blue-concrete-textured-wall.jpg" Stretch="UniformToFill"/>
    </Page.Background>
    <Page.Resources>
        <!-- BOTÕES MENU -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#1F3A5F"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- BOTÃO PRINCIPAL -->
        <Style x:Key="CTAButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1F3A5F"/>
            <Setter Property="Foreground" Value="#F3E6C9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <!-- remove o fundo azul -->
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- SETAS DO EVENTO -->
        <Style x:Key="ArrowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFF7E1"/>
            <Setter Property="Foreground" Value="#B8860B"/>
            <Setter Property="BorderBrush" Value="#B8860B"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="brd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="brd" Property="Background" Value="#C99A2E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="brd" Property="Background" Value="#8B6914"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <!-- APRESENTAÇÃO -->
            <Border Background="#EDE3D1" CornerRadius="20" Padding="28" Margin="0,10,0,24" BorderBrush="#C9B27D" BorderThickness="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>
                    <!-- TEXO -->
                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Text="Bem-vindo à ALAHC" FontFamily="Georgia" FontSize="30" FontWeight="Bold" Foreground="#1F3A5F" Margin="0,0,0,12"/>
                        <TextBlock Text="A Academia de Letras, Artes e História de Cruzeiro preserva a memória cultural da cidade e incentiva artistas, escritores e projetos culturais da região." FontSize="15" Foreground="#444444" TextWrapping="Wrap" LineHeight="24" Margin="0,0,0,10"/>
                        <TextBlock Text="Explore eventos, artistas, obras e publicações da comunidade em um ambiente moderno e acessível." FontSize="15" Foreground="#444444" TextWrapping="Wrap" LineHeight="24" Margin="0,0,0,18"/>
                        <Button Content="Saiba mais" Style="{StaticResource CTAButtonStyle}" Width="150" Height="42" Background="#1F3A5F" Foreground="#F3E6C9" FontWeight="Bold" BorderBrush="#B8860B" BorderThickness="2" Cursor="Hand" Click="BtnSobreNos_Click"/>
                    </StackPanel>
                    <!-- LOGO -->
                    <Border Grid.Column="1" Background="Transparent" CornerRadius="18" Padding="10">
                        <Image Source="/ImagemAcelera/ALAHCPNG.png" Stretch="Uniform"/>
                    </Border>
                </Grid>
            </Border>
            <!-- EVENTO EM DESTAQUE -->
            <Border Margin="20,16" CornerRadius="26" Padding="2" BorderBrush="#B8860B" BorderThickness="2">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0B2A3A" Offset="0"/>
                        <GradientStop Color="#123F5F" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border CornerRadius="24" Padding="24" Background="#0F3A5F">
                    <StackPanel>
                        <!-- CABEÇALHO -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Evento em destaque" FontFamily="Georgia" FontSize="24" FontWeight="Bold" Foreground="#F3E6C9"/>
                                <TextBlock Text="Confira a programação cultural selecionada pela ALAHC" FontSize="12" Foreground="#D6C28F" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#B8860B" CornerRadius="14" Padding="12,6" VerticalAlignment="Center">
                                <TextBlock Text="DESTAQUE" FontSize="11" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </Grid>
                        <!-- CONTEÚDO -->
                        <Grid Height="420">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="430"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- CARD DA IMAGEM -->
                            <Border Grid.Column="0" Background="#EDE3D1" BorderBrush="#B8860B" BorderThickness="1.5" CornerRadius="20" Padding="14" Margin="0,0,22,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="EVENTO CULTURAL" FontFamily="Georgia" FontSize="11" FontWeight="Bold" Foreground="#8B6914" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="#1F3A5F" CornerRadius="10" Padding="8,3">
                                            <TextBlock Text="ALAHC" Foreground="#F3E6C9" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                    <Border Grid.Row="1" CornerRadius="18" ClipToBounds="True" BorderBrush="#C9B27D" BorderThickness="1" Background="#D8C7A2">
                                        <Image x:Name="imgEvento" Source="/ImagemAcelera/evento1.png" Stretch="UniformToFill"/>
                                    </Border>
                                    <Border Grid.Row="2" Background="#FFF7E1" BorderBrush="#C9B27D" BorderThickness="1" CornerRadius="12" Padding="10,7" Margin="0,12,0,0">
                                        <TextBlock x:Name="txtData" FontFamily="Georgia" FontSize="12" FontWeight="Bold" Foreground="#1F3A5F" TextAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <!-- CARD DO TEXTO -->
                            <Border Grid.Column="1" Background="#EDE3D1" BorderBrush="#B8860B" BorderThickness="1.5" CornerRadius="20" Padding="22">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="txtTitulo" Grid.Row="0" FontFamily="Georgia" FontSize="26" FontWeight="Bold" Foreground="#1F3A5F" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                    <!-- DESCRIÇÃO E PROGRAMAÇÃO COM SCROLL -->
                                    <Border Grid.Row="1" BorderBrush="#C9B27D" BorderThickness="1" CornerRadius="12" Background="#FFF7E1" Padding="12">
                                        <ScrollViewer MaxHeight="245" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="Descrição" FontFamily="Georgia" FontSize="13" FontWeight="Bold" Foreground="#1F3A5F" Margin="0,0,0,4"/>
                                                <TextBlock x:Name="txtDescricao" FontFamily="Georgia" FontSize="14" Foreground="#333333" TextWrapping="WrapWithOverflow" LineHeight="22" Margin="0,0,0,12"/>
                                                <Rectangle Height="1" Fill="#1F3A5F" Margin="0,0,0,12"/>
                                                <TextBlock Text="Programação / Cronograma" FontFamily="Georgia" FontSize="13" FontWeight="Bold" Foreground="#1F3A5F" Margin="0,0,0,4"/>
                                                <TextBlock x:Name="txtDetalhes" TextWrapping="WrapWithOverflow" FontFamily="Georgia" FontSize="13" Foreground="#333333" LineHeight="22"/>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                    <!-- RODAPÉ DO CARD DO EVENTO -->
                                    <Grid Grid.Row="2" Margin="0,14,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <!-- LOCAL -->
                                        <TextBlock Grid.Row="0" Margin="0,0,0,12" TextWrapping="Wrap">
                      <Run Text="Local: " Foreground="#1F3A5F" FontWeight="Bold"/>
                      <Run x:Name="txtLocalEventoHome" Foreground="#333333"/>
                                        </TextBlock>
                                        <!-- BOTÃO + TEXTO AUXILIAR -->
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Content="VER PROGRAMAÇÃO" Style="{StaticResource CTAButtonStyle}" Width="220" Height="40" Background="#1F3A5F" Foreground="#F3E6C9" FontWeight="Bold" BorderBrush="#B8860B" BorderThickness="1.5" HorizontalAlignment="Left" Click="Programacao_Click"/>
                                            <TextBlock Grid.Column="1" Text="Clique para ver todos os eventos no calendário" Foreground="#8A7A55" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                        <!-- SETAS -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                            <Button Style="{StaticResource ArrowButtonStyle}" Content="◀" Click="BtnAnterior_Click"/>
                            <Button Style="{StaticResource ArrowButtonStyle}" Content="▶" Margin="12,0,0,0" Click="BtnProximo_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
            <!-- ARTISTAS EM DESTAQUE -->
            <Border Background="#0D3348" CornerRadius="10" BorderBrush="#B8860B" BorderThickness="1" Padding="20,16" Margin="20,16">
                <StackPanel>
                    <TextBlock Text="ARTISTAS EM DESTAQUE" FontFamily="Georgia" FontSize="16" FontWeight="Bold" Foreground="#F3E6C9" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                    <WrapPanel x:Name="painelArtistasDestaque" HorizontalAlignment="Center"/>
                    <Button Content="VEJA MAIS ARTISTAS" Style="{StaticResource CTAButtonStyle}" Background="#B8860B" HorizontalAlignment="Center" Margin="0,14,0,0" Click="Artistas_Click"/>
                </StackPanel>
            </Border>
            <!-- FEED E ARTISTAS RECENTES -->
            <Grid Margin="20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="#B8860B" BorderThickness="2" CornerRadius="16" Padding="5" Margin="0,0,20,0" MinHeight="400">
                    <StackPanel x:Name="painelFeedPublicacoes"/>
                </Border>
                <!-- ARTISTAS RECENTES -->
                <Border Grid.Column="1" Background="#0D3348" BorderBrush="#B8860B" BorderThickness="2" CornerRadius="16" Padding="12">
                    <StackPanel>
                        <TextBlock Text="ARTISTAS RECENTES" FontSize="18" FontWeight="Bold" FontFamily="Georgia" Foreground="#F3E6C9" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                        <StackPanel x:Name="painelArtistasRecentes"/>
                    </StackPanel>
                </Border>
            </Grid>
            <!-- CRUZEIRO -->
            <Border Margin="20,6,20,20" CornerRadius="10" ClipToBounds="True" Height="170">
                <Grid>
                    <Image Source="/ImagemAcelera/cruzeiro.png" Stretch="UniformToFill"/>
                    <Border Background="#90000000"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="CONHEÇA CRUZEIRO" Foreground="#F3E6C9" FontFamily="Georgia" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="O orgulho do Vale do Paraíba" Foreground="#EDD89A" FontFamily="Georgia" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <Button Content="VEJA MAIS" Style="{StaticResource CTAButtonStyle}" HorizontalAlignment="Center" Click="NossaCidade_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Page>