<Page x:Class="ProjetoAcelera.Views.Calendario.Calendario"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              MinWidth="1080" MinHeight="1050">
    <Page.Background>
        <ImageBrush ImageSource="/ImagemAcelera/solid-navy-blue-concrete-textured-wall.jpg"
                Stretch="UniformToFill"/>
    </Page.Background>
    <Page.Resources>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Background" Value="#D6C28F"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="#D6C28F">

                            <Track x:Name="PART_Track"
                               IsDirectionReversed="True"
                               Focusable="False">

                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                              Opacity="0"
                                              Focusable="False"/>
                                </Track.DecreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb>

                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">

                                                <Border Background="#B8860B"
                                                    CornerRadius="6"
                                                    Margin="2"/>

                                            </ControlTemplate>
                                        </Thumb.Template>

                                    </Thumb>
                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                              Opacity="0"
                                              Focusable="False"/>
                                </Track.IncreaseRepeatButton>

                            </Track>
                        </Grid>
                    </ControlTemplate>

                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>
    <Grid >
        <!-- MENU SUPERIOR -->
        <TextBlock Text="PRÓXIMOS ENCONTROS"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#B8860B"
                   HorizontalAlignment="Center"
                   FontFamily="Inter"
                   Margin="0,60,0,0"/>

        <Border Background="#EDE3D1"
                CornerRadius="15"
                Padding="25"
                Width="620"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,80,0,0">

            <StackPanel>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btnAnterior"
                            Content="◀"
                            FontSize="18"
                            Width="40" Height="40"
                            Background="#B8860B"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnAnterior_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="20">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock x:Name="txtMes"
                               Grid.Column="1"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#2C3E50"/>

                    <Button x:Name="btnProximo"
                            Grid.Column="2"
                            Content="▶"
                            FontSize="18"
                            Width="40" Height="40"
                            Background="#B8860B"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnProximo_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="20">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <UniformGrid Columns="7" Margin="0,0,0,10">
                    <TextBlock Text="Seg" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#2C3E50"/>
                    <TextBlock Text="Ter" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#2C3E50"/>
                    <TextBlock Text="Qua" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#2C3E50"/>
                    <TextBlock Text="Qui" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#2C3E50"/>
                    <TextBlock Text="Sex" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#2C3E50"/>
                    <TextBlock Text="Sáb" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#2C3E50"/>
                    <TextBlock Text="Dom" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#2C3E50"/>
                </UniformGrid>

                <Border BorderBrush="#B8860B"
                        BorderThickness="2"
                        Padding="10"
                        CornerRadius="8">
                    <Border.Background>
                        <ImageBrush ImageSource="/ImagemAcelera/fundo-pintado-mao-da-aguarela_24972-1199.avif"
                                    Stretch="UniformToFill"
                                    Opacity="0.75"/>
                    </Border.Background>

                    <UniformGrid x:Name="gridDias"
                                 Columns="7"
                                 Margin="0,5,0,0"/>
                </Border>

                <StackPanel Margin="0,25,0,0">

                    <TextBlock x:Name="txtDataSelecionada"
                               Text="Selecione um dia no calendário"
                               FontWeight="Bold"
                               FontSize="15"
                               Foreground="#B8860B"
                               Margin="0,0,0,10"/>

                    <ItemsControl x:Name="listaEventosDoDia">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Border Background="#FFF7E1"
                                        BorderBrush="#B8860B"
                                        BorderThickness="1.5"
                                        CornerRadius="12"
                                        Padding="12"
                                        Margin="0,0,0,12">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="210"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- INFORMAÇÕES DO EVENTO -->
                                        <StackPanel Grid.Column="0"
                                                    Margin="0,0,12,0">

                                            <TextBlock Text="{Binding Titulo}"
                                                        FontWeight="Bold"
                                                        FontSize="16"
                                                        Foreground="#1F3A5F"
                                                        TextWrapping="Wrap"/>

                                            <ScrollViewer MaxHeight="170"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          Margin="0,6,0,0">

                                                <StackPanel>

                                                    <TextBlock Text="Descrição"
                                                               FontWeight="Bold"
                                                               Foreground="#1F3A5F"
                                                               FontSize="12"/>

                                                    <TextBlock Text="{Binding Descricao}"
                                                               TextWrapping="Wrap"
                                                               Foreground="#333333"
                                                               Margin="0,3,0,8"/>
                                                    <Border Height="1.5"
                                                            Background="#1F3A5F"
                                                            Margin="0,4,0,8"/>
                                                    <TextBlock Text="Programação / Cronograma"
                                                               FontWeight="Bold"
                                                               Foreground="#1F3A5F"
                                                               FontSize="12"/>

                                                    <TextBlock Text="{Binding Programacao}"
                                                               TextWrapping="Wrap"
                                                               Foreground="#333333"
                                                               Margin="0,3,0,0"/>

                                                </StackPanel>
                                            </ScrollViewer>
                                            <TextBlock Margin="0,8,0,0">
                                                    <Run Text="Local: " Foreground="#1F3A5F" FontWeight="Bold"/>
                                                    <Run Text="{Binding Local}" Foreground="#333333"/>
                                            </TextBlock>
                                            <TextBlock Margin="0,6,0,0"
                                                       FontSize="12">
                                                    <Run Text="Início: " Foreground="#1F3A5F" FontWeight="Bold"/>
                                                    <Run Text="{Binding DataInicio, StringFormat={}{0:dd/MM/yyyy}}" Foreground="#333333"/>
                                            </TextBlock>

                                            <TextBlock Margin="0,2,0,0"
                                                      FontSize="12">
                                                     <Run Text="Fim: " Foreground="#1F3A5F" FontWeight="Bold"/>
                                                     <Run Text="{Binding DataFim, StringFormat={}{0:dd/MM/yyyy}}" Foreground="#333333"/>
                                            </TextBlock>

                                        </StackPanel>

                                        <!-- IMAGEM DO EVENTO -->
                                        <Border Grid.Column="1"
                                                Width="200"
                                                Height="170"
                                                CornerRadius="0"
                                                ClipToBounds="True"
                                                BorderBrush="#1F3A5F"
                                                BorderThickness="1.5"
                                                Background="#EDE3D1"
                                                VerticalAlignment="Top">

                                            <Image Source="{Binding Imagem}"
                                                   Stretch="UniformToFill"
                                                   Cursor="Hand"
                                                   MouseDown="AbrirImagemEvento_Click"/>

                                        </Border>
                                    </Grid>
                                </Border>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Page>
