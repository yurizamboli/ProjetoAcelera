<Page x:Class="ProjetoAcelera.Views.Admin.ContainerPainelAdmin"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">
    <Page.Resources>

 <!-- BOTÃO PADRÃO AZUL -->
<Style x:Key="BotaoAzul" TargetType="Button">
    <Setter Property="Height" Value="34"/>
    <Setter Property="Padding" Value="14,5"/>
    <Setter Property="Background" Value="#1F3A5F"/>
    <Setter Property="Foreground" Value="#F3E6C9"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Margin" Value="0,6,8,0"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>


    <!-- REMOVE HOVER / CLICK / FOCUS -->
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="8">
                    
                    <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                    
                </Border>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>

<!-- REMOVE HOVER DO LISTBOX -->
<Style TargetType="ListBoxItem">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="OverridesDefaultStyle" Value="True"/>

    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
                
                <Border Background="Transparent">
                    <ContentPresenter/>
                </Border>

            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>

<!-- REMOVE HOVER DO LISTVIEW -->
<Style TargetType="ListViewItem">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="OverridesDefaultStyle" Value="True"/>

    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="ListViewItem">
                
                <Border Background="Transparent">
                    <ContentPresenter/>
                </Border>

            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>


        <!-- BOTÃO DOURADO -->
        <Style x:Key="BotaoDourado" TargetType="Button" BasedOn="{StaticResource BotaoAzul}">
            <Setter Property="Background" Value="#B8860B"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- BOTÃO VERMELHO -->
        <Style x:Key="BotaoVermelho" TargetType="Button" BasedOn="{StaticResource BotaoAzul}">
            <Setter Property="Background" Value="#8B1E1E"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <!-- BOTÃO VERDE -->
            <Style x:Key="BotaoVerde"
                   TargetType="Button"
                   BasedOn="{StaticResource BotaoAzul}">
    
                <Setter Property="Background" Value="#2E7D32"/>
                <Setter Property="Foreground" Value="White"/>
    
            </Style>

        <!-- TEXTBOX PADRÃO -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Background" Value="#FFF7E1"/>
            <Setter Property="Foreground" Value="#1F3A5F"/>
            <Setter Property="BorderBrush" Value="#C9B27D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- COMBOBOX PADRÃO -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Background" Value="#FFF7E1"/>
            <Setter Property="Foreground" Value="#1F3A5F"/>
            <Setter Property="BorderBrush" Value="#C9B27D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,2"/>
        </Style>

        <!-- DATEPICKER PADRÃO -->
        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Background" Value="#FFF7E1"/>
            <Setter Property="Foreground" Value="#1F3A5F"/>
            <Setter Property="BorderBrush" Value="#C9B27D"/>
        </Style>

        <!-- TÍTULO DOS CARDS -->
        <Style x:Key="TituloCard" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1F3A5F"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- SUBTÍTULO -->
        <Style x:Key="Subtitulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Margin" Value="0,-6,0,10"/>
        </Style>

    </Page.Resources>

    <Grid Background="Transparent">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="5">

                <TextBlock Text="Painel Administrativo"
                               FontSize="30"
                               FontWeight="Bold"
                               FontFamily="Georgia"
                               Foreground="#1F3A5F"
                               HorizontalAlignment="Left"
                               Margin="0,0,0,22"/>

                <!-- EVENTOS -->
                <Border Background="#FFF7E1"
                        BorderBrush="#C9B27D"
                        BorderThickness="2"
                        CornerRadius="18"
                        Padding="16"
                        Margin="0,0,0,18">

                    <StackPanel>

                        <TextBlock Text="Criar Evento"
               Style="{StaticResource TituloCard}"/>

                        <TextBlock Text="Cadastre um novo evento cultural para exibição no sistema."
               Style="{StaticResource Subtitulo}"/>

                        <TextBlock Text="Título do evento"
               FontWeight="Bold"
               Foreground="#1F3A5F"
               Margin="0,6,0,0"/>

                        <TextBox x:Name="txtTituloEvento"
             ToolTip="Título do evento"/>

                        <TextBlock Text="Descrição do evento"
               FontWeight="Bold"
               Foreground="#1F3A5F"
               Margin="0,10,0,0"/>

                        <TextBox x:Name="txtDescEvento"
             Height="80"
             TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto"
             ToolTip="Descrição do evento"/>

                        <TextBlock Text="Programação ou detalhes"
               FontWeight="Bold"
               Foreground="#1F3A5F"
               Margin="0,10,0,0"/>

                        <TextBox x:Name="txtProgramacaoEvento"
             Height="80"
             TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto"
             ToolTip="Programação ou detalhes do evento"/>

                        <TextBlock Text="Local do evento"
               FontWeight="Bold"
               Foreground="#1F3A5F"
               Margin="0,10,0,0"/>

                        <TextBox x:Name="txtLocalEvento"
             ToolTip="Local do evento"/>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                    Margin="0,0,8,0">

                                <TextBlock Text="Data de início"
                       FontWeight="Bold"
                       Foreground="#1F3A5F"/>

                                <DatePicker x:Name="dateEventoInicio"/>

                            </StackPanel>

                            <StackPanel Grid.Column="1"
                    Margin="8,0,0,0">

                                <TextBlock Text="Data de fim"
                       FontWeight="Bold"
                       Foreground="#1F3A5F"/>

                                <DatePicker x:Name="dateEventoFim"/>

                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Imagem do evento"
               FontWeight="Bold"
               Foreground="#1F3A5F"
               Margin="0,10,0,0"/>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Content="Selecionar Imagem"
                Style="{StaticResource BotaoAzul}"
                Click="SelecionarImagemEvento_Click"/>

                            <TextBox x:Name="txtCaminhoImagem"
                 Grid.Column="1"
                 Text="Selecione uma imagem..."
                 IsReadOnly="True"
                 Foreground="#666666"/>
                        </Grid>

                        <CheckBox x:Name="checkEventoDestaque"
              Content="Exibir este evento em destaque na Home"
              Foreground="#1F3A5F"
              FontWeight="Bold"
              Margin="0,10,0,0"
              IsChecked="True"/>

                        <Button Content="Adicionar Evento"
            Style="{StaticResource BotaoDourado}"
            Width="180"
            HorizontalAlignment="Right"
            Click="AdicionarEvento_Click"/>

                    </StackPanel>
                </Border>

                <!-- GERENCIAR EVENTOS -->
                <Border Background="#FFF7E1"
                        BorderBrush="#C9B27D"
                        BorderThickness="2"
                        CornerRadius="18"
                        Padding="16"
                        Margin="0,0,0,18">

                    <StackPanel>

                        <TextBlock Text="Gerenciar Eventos"
                                      Style="{StaticResource TituloCard}"/>

                        <TextBlock Text="Visualize e remova eventos cadastrados."
                                     Style="{StaticResource Subtitulo}"/>

                        <ListBox x:Name="listaEventos"
                                 Margin="0,8,0,0"
                                 Height="220"
                                 SelectionMode="Single"
                                 Background="#F3E6C9"
                                 BorderBrush="#C9B27D"
                                 HorizontalContentAlignment="Stretch">

                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#1F3A5F"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">

                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="10"
                                                        Padding="{TemplateBinding Padding}">

                                                    <ContentPresenter/>

                                                </Border>

                                                <ControlTemplate.Triggers>

                                                    <Trigger Property="IsMouseOver"
                                                             Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="#E8D9B5"/>
                                                    </Trigger>

                                                    <Trigger Property="IsSelected"
                                                              Value="True">
                                                        <Setter TargetName="Bd"
                                                               Property="Background"
                                                                Value="#D6C28F"/>   
                                                    </Trigger>

                                                </ControlTemplate.Triggers>

                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>

                                    <Border Background="#FFF7E1"
                                            BorderBrush="#D6C28F"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="10"
                                            Margin="0,0,0,8"
                                            HorizontalAlignment="Stretch">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="160"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- IMAGEM DO EVENTO -->
                                            <Border Grid.Column="0"
                                                    Width="65"
                                                    Height="65"
                                                    CornerRadius="8"
                                                    ClipToBounds="True"
                                                    BorderBrush="#1F3A5F"
                                                    BorderThickness="1.5"
                                                    VerticalAlignment="Center">

                                                <Image Source="{Binding Imagem}"
                                                         Stretch="UniformToFill"/>
                                            </Border>

                                            <!-- INFORMAÇÕES -->
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Margin="8,0,0,0">

                                                <TextBlock Text="{Binding Titulo}"
                                                           FontWeight="Bold"
                                                           FontSize="15"
                                                           Foreground="#1F3A5F"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <TextBlock Text="{Binding DataInicio, StringFormat='Início: {0:dd/MM/yyyy}'}"
                                                           FontSize="12"
                                                           Foreground="#8A7A55"
                                                           Margin="0,3,0,0"/>

                                                <TextBlock Text="{Binding DataFim, StringFormat='Fim: {0:dd/MM/yyyy}'}"
                                                           FontSize="12"
                                                           Foreground="#8A7A55"
                                                           Margin="0,3,0,0"/>

                                                <TextBlock Text="{Binding Local}"
                                                           FontSize="12"
                                                           Foreground="#555555"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,3,0,0"/>

                                            </StackPanel>

                                            <!-- STATUS -->
                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Right">

                                                <TextBlock Text="Evento cadastrado"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="#1F3A5F"
                                                           HorizontalAlignment="Right"/>

                                                <TextBlock Text="{Binding Destaque, StringFormat='Destaque: {0}'}"
                                                           FontSize="11"
                                                           Foreground="#8A7A55"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,3,0,0"/>

                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,8,0,0">

                            <Button Content="Deletar"
                                    Width="100"
                                    Style="{StaticResource BotaoVermelho}"
                                    Click="DeletarEvento_Click"/>

                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- USUÁRIOS -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- DESTAQUE -->
                    <Border Grid.Column="0"
                                Background="#FFF7E1"
                                BorderBrush="#C9B27D"
                                BorderThickness="2"
                                CornerRadius="18"
                                Padding="16"
                                Margin="0,0,10,0">

                        <StackPanel>
                            <TextBlock Text="Destacar Usuário"
                                           Style="{StaticResource TituloCard}"/>

                            <TextBlock Text="Escolha artistas para aparecerem em destaque na Home."
                                           Style="{StaticResource Subtitulo}"/>

                            <ComboBox x:Name="comboUsuarios"/>

                            <Button Content="Colocar em destaque"
                                        Style="{StaticResource BotaoDourado}"
                                        Margin="0,10,0,0"
                                        Click="Destaque_Click"/>

                            <TextBlock Text="Artistas em destaque"
                                           FontWeight="Bold"
                                           Foreground="#1F3A5F"
                                           Margin="0,14,0,6"/>

                            <ListBox x:Name="listaDestaques"
         Height="260"
         Background="#F3E6C9"
         BorderBrush="#C9B27D"
         ScrollViewer.VerticalScrollBarVisibility="Visible"
         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
         HorizontalContentAlignment="Stretch">

                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,8"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FFF7E1"
                    BorderBrush="#D6C28F"
                    BorderThickness="1"
                    CornerRadius="10"
                    Height="72"
                    Margin="0,0,0,8"
                    Padding="10"
                    HorizontalAlignment="Stretch">

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="90"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- FOTO -->
                                                <Border Width="48"
                            Height="48"
                            CornerRadius="8"
                            ClipToBounds="True"
                            BorderBrush="#1F3A5F"
                            BorderThickness="1.5"
                            VerticalAlignment="Center">

                                                    <Image Source="{Binding Perfil.FotoPerfil}"
                               Stretch="UniformToFill"/>
                                                </Border>

                                                <!-- TEXTO -->
                                                <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Margin="8,0,0,0">

                                                    <TextBlock Text="{Binding Nome}"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="#1F3A5F"
                                   TextTrimming="CharacterEllipsis"/>

                                                    <TextBlock Text="Artista em destaque"
                                   FontSize="11"
                                   Foreground="#8A7A55"/>
                                                </StackPanel>

                                                <!-- BOTÃO -->
                                                <Button Grid.Column="2"
                            Content="Remover"
                            Width="78"
                            Height="30"
                            FontSize="11"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource BotaoVermelho}"
                            Padding="0"
                            Margin="0"
                            Tag="{Binding}"
                            Click="RemoverDestaque_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- PROMOVER -->
                    <Border Grid.Column="1"
                                Background="#FFF7E1"
                                BorderBrush="#C9B27D"
                                BorderThickness="2"
                                CornerRadius="18"
                                Padding="16"
                                Margin="10,0,10,0">

                        <StackPanel>
                            <TextBlock Text="Promover para Admin"
                                           Style="{StaticResource TituloCard}"/>

                            <TextBlock Text="Transforme um usuário comum em administrador."
                                           Style="{StaticResource Subtitulo}"/>

                            <ComboBox x:Name="comboPromover"/>

                    <Button Content="Promover"
                            Style="{StaticResource BotaoVerde}"
                            Margin="0,10,0,0"
                            Click="Promover_Click"/>
                            <TextBlock Text="Administradores promovidos"
                                       FontWeight="Bold"
                                       Foreground="#1F3A5F"
                                       Margin="0,14,0,6"/>

                            <ListBox x:Name="listaAdmins"
                                     Height="260"
                                     Background="#F3E6C9"
                                     BorderBrush="#C9B27D"
                                     ScrollViewer.VerticalScrollBarVisibility="Visible"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     HorizontalContentAlignment="Stretch">

                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,8"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FFF7E1"
                                                BorderBrush="#D6C28F"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Height="72"
                                                Margin="0,0,0,8"
                                                Padding="10"
                                                HorizontalAlignment="Stretch">

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="90"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- FOTO -->
                                                <Border Width="48"
                                                        Height="48"
                                                        CornerRadius="8"
                                                        ClipToBounds="True"
                                                        BorderBrush="#2E7D32"
                                                        BorderThickness="1.5"
                                                        VerticalAlignment="Center">

                                                    <Image Source="{Binding Perfil.FotoPerfil}"
                                                            Stretch="UniformToFill"/>
                                                </Border>

                                                <!-- TEXTO -->
                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Margin="8,0,0,0">

                                                    <TextBlock Text="{Binding Nome}"
                                                               FontWeight="Bold"
                                                               FontSize="14"
                                                               Foreground="#1F3A5F"
                                                               TextTrimming="CharacterEllipsis"/>

                                                    <TextBlock Text="Administrador promovido"
                                                               FontSize="11"
                                                               Foreground="#8A7A55"/>
                                                </StackPanel>

                                                <!-- BOTÃO -->
                                            <Button Grid.Column="2"
                                                    Content="Remover"
                                                    Width="78"
                                                    Height="30"
                                                    FontSize="11"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource BotaoVermelho}"
                                                    Padding="0"
                                                    Margin="0"
                                                    Tag="{Binding}"
                                                    Click="RemoverAdmin_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                        
                    </Border>

                    <!-- BANIR -->
                    <!-- BANIR -->
                    <Border Grid.Column="2"
        Background="#FFF7E1"
        BorderBrush="#C9B27D"
        BorderThickness="2"
        CornerRadius="18"
        Padding="16"
        Margin="10,0,0,0">

                        <StackPanel>
                            <TextBlock Text="Banir Usuário"
                   Style="{StaticResource TituloCard}"/>

                            <TextBlock Text="Bloqueie usuários que não devem acessar o sistema."
                   Style="{StaticResource Subtitulo}"/>

                            <ComboBox x:Name="comboBanir"/>

                            <Button Content="Banir"
                                    Style="{StaticResource BotaoVermelho}"
                                    Margin="0,10,0,0"
                                    Click="Banir_Click"/>

                            <TextBlock Text="Usuários banidos"
                                       FontWeight="Bold"
                                       Foreground="#1F3A5F"
                                       Margin="0,14,0,6"/>

                            <ListBox x:Name="listaBanidos"
         Height="260"
         Background="#F3E6C9"
         BorderBrush="#C9B27D"
         ScrollViewer.VerticalScrollBarVisibility="Visible"
         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
         HorizontalContentAlignment="Stretch">

                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,8"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FFF7E1"
                    BorderBrush="#D6C28F"
                    BorderThickness="1"
                    CornerRadius="10"
                    Height="72"
                    Margin="0,0,0,8"
                    Padding="10"
                    HorizontalAlignment="Stretch">

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="90"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- FOTO -->
                                                <Border Width="48"
                            Height="48"
                            CornerRadius="8"
                            ClipToBounds="True"
                            BorderBrush="#8B1E1E"
                            BorderThickness="1.5"
                            VerticalAlignment="Center">

                                                    <Image Source="{Binding Perfil.FotoPerfil}"
                               Stretch="UniformToFill"/>
                                                </Border>

                                                <!-- TEXTO -->
                                                <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Margin="8,0,0,0">

                                                    <TextBlock Text="{Binding Nome}"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="#8B1E1E"
                                   TextTrimming="CharacterEllipsis"/>

                                                    <TextBlock Text="Usuário banido"
                                   FontSize="11"
                                   Foreground="#8A7A55"/>
                                                </StackPanel>

                                                <!-- BOTÃO -->
                                         <Button Grid.Column="2"
                                                Content="Liberar"
                                                Width="78"
                                                Height="30"
                                                FontSize="11"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource BotaoVerde}"
                                                Padding="0"
                                                Margin="0"
                                                Tag="{Binding}"
                                                Click="RemoverBanimento_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- POSTAGENS PENDENTES -->
                <Border Background="#FFF7E1"
                            BorderBrush="#C9B27D"
                            BorderThickness="2"
                            CornerRadius="18"
                            Padding="16"
                            Margin="0,0,0,20">

                    <StackPanel>
                        <TextBlock Text="Postagens Pendentes"
                                       Style="{StaticResource TituloCard}"/>

                        <TextBlock Text="Analise as publicações enviadas pelos usuários antes de liberar no feed global."
                                       Style="{StaticResource Subtitulo}"/>

                        <ListView x:Name="listaPostagensPendentes"
                                      Margin="0,10,0,0"
                                      Height="430"
                                      SelectionMode="Single"
                                      Background="#F3E6C9"
                                      BorderBrush="#C9B27D"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">

                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,10"/>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate>

                                    <Border Background="#FFF7E1"
                                                BorderBrush="#1F3A5F"
                                                BorderThickness="2"
                                                MaxWidth="930"
                                                Height="425"
                                                CornerRadius="14"
                                                Padding="12"
                                                Margin="0,0,0,15"
                                                HorizontalAlignment="Stretch">

                                        <Grid>

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0"
                                                           Text="{Binding NomeAutor}"
                                                           FontWeight="Bold"
                                                           FontSize="15"
                                                           Foreground="#1F3A5F"/>

                                            <ScrollViewer Grid.Row="1"
                                                              MaxHeight="100"
                                                              VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled"
                                                              Margin="0,8,0,0">

                                                <TextBlock Text="{Binding Conteudo}"
                                                               TextWrapping="Wrap"
                                                               Foreground="#333333"/>

                                            </ScrollViewer>

                                            <Border Grid.Row="2"
                                                        CornerRadius="12"
                                                        Margin="0,10,0,10"
                                                        ClipToBounds="True"
                                                        BorderBrush="#C9B27D"
                                                        BorderThickness="1"
                                                        Background="#E8E1CF">

                                                <Image Source="{Binding ImagemUrl}"
                                                           Height="200"
                                                           Stretch="UniformToFill"
                                                           Cursor="Hand"
                                                           MouseDown="AbrirImagem_Click"/>

                                            </Border>

                                            <Grid Grid.Row="3"
                                                      Margin="0,8,0,0"
                                                      VerticalAlignment="Bottom">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="Deseja publicar esta postagem no feed global?"
                                                               Foreground="#1F3A5F"
                                                               FontWeight="Bold"
                                                               VerticalAlignment="Center"/>

                                            <Button Grid.Column="1"
                                                    Content="Publicar na Home"
                                                    Style="{StaticResource BotaoDourado}"
                                                    Width="145"
                                                    Tag="{Binding}"
                                                    Click="AprovarPostagem_Click"/>

                                                <Button Grid.Column="2"
                                                        Content="Não publicar"
                                                        Style="{StaticResource BotaoVermelho}"
                                                        Width="125"
                                                        Tag="{Binding}"
                                                        Click="ReprovarPostagem_Click"/>

                                            </Grid>

                                        </Grid>
                                    </Border>

                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
                <!-- POSTAGENS PUBLICADAS NA HOME -->
                <Border Background="#FFF7E1"
                        BorderBrush="#C9B27D"
                        BorderThickness="2"
                        CornerRadius="18"
                        Padding="16"
                        Margin="0,0,0,20">

                    <StackPanel>
                        <TextBlock Text="Postagens Publicadas na Home"
                                     Style="{StaticResource TituloCard}"/>

                        <TextBlock Text="Gerencie as publicações que já estão aparecendo no feed global da Home."
                                   Style="{StaticResource Subtitulo}"/>

                        <ListView x:Name="listaPostagensPublicadas"
                                  Margin="0,10,0,0"
                                  Height="430"
                                  SelectionMode="Single"
                                  Background="#F3E6C9"
                                  BorderBrush="#C9B27D"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">

                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,10"/>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate>

                                    <Border Background="#FFF7E1"
                                            BorderBrush="#1F3A5F"
                                            BorderThickness="2"
                                            MaxWidth="930"
                                            Height="425"
                                            CornerRadius="14"
                                            Padding="12"
                                            Margin="0,0,0,15"
                                            HorizontalAlignment="Stretch">

                                        <Grid>

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0"
                                                       Text="{Binding NomeAutor}"
                                                       FontWeight="Bold"
                                                       FontSize="15"
                                                       Foreground="#1F3A5F"/>

                                            <ScrollViewer Grid.Row="1"
                                                          MaxHeight="100"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          Margin="0,8,0,0">

                                                <TextBlock Text="{Binding Conteudo}"
                                                           TextWrapping="Wrap"
                                                           Foreground="#333333"/>

                                            </ScrollViewer>

                                            <Border Grid.Row="2"
                                                    CornerRadius="12"
                                                    Margin="0,10,0,10"
                                                    ClipToBounds="True"
                                                    BorderBrush="#C9B27D"
                                                    BorderThickness="1"
                                                    Background="#E8E1CF">

                                                <Image Source="{Binding ImagemUrl}"
                                                       Height="200"
                                                       Stretch="UniformToFill"
                                                       Cursor="Hand"
                                                       MouseDown="AbrirImagem_Click"/>

                                            </Border>

                                            <Grid Grid.Row="3"
                                                  Margin="0,8,0,0"
                                                  VerticalAlignment="Bottom">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="Esta publicação está aparecendo na Home."
                                                           Foreground="#1F3A5F"
                                                           FontWeight="Bold"
                                                           VerticalAlignment="Center"/>

                                                <Button Grid.Column="1"
                                                        Content="Remover da Home"
                                                        Style="{StaticResource BotaoVermelho}"
                                                        Width="150"
                                                        Tag="{Binding}"
                                                        Click="RemoverDaHome_Click"/>

                                            </Grid>

                                        </Grid>
                                    </Border>

                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </StackPanel>
            
        </ScrollViewer>
    </Grid>
</Page>