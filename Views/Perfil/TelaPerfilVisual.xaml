<Page x:Class="ProjetoAcelera.Views.Perfil.TelaPerfilVisual"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      MinHeight="800"
      MinWidth="1000"
      Background="Transparent">
      <Page.Resources>

    <Style x:Key="PerfilTabButtonStyle" TargetType="Button">

        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="#F3E6C9"/>
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="Template">
            <Setter.Value>

                <ControlTemplate TargetType="Button">

                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            Padding="6">

                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>

                        <!-- HOVER -->
                        <Trigger Property="IsMouseOver"
                                 Value="True">

                            <Setter TargetName="bd"
                                    Property="Background"
                                    Value="#30D4AF37"/>
                        </Trigger>

                        <!-- CLICK -->
                        <Trigger Property="IsPressed"
                                 Value="True">

                            <Setter TargetName="bd"
                                    Property="Background"
                                    Value="#60D4AF37"/>
                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>
        </Setter>

    </Style>

</Page.Resources>
    <Grid Width="1076">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- PERFIL -->
        <Border Grid.Row="0"
                Background="#F3E6C9"
                CornerRadius="20"
                BorderBrush="#C9B27D"
                BorderThickness="2"
                Margin="20,15,20,15"
                Padding="25">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- FOTO -->
            <Border BorderBrush="#1F3A5F"
                    BorderThickness="3"
                    Width="170"
                    Height="170"
                    Background="#1F3A5F"
                    CornerRadius="12"
                    Padding="4"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center">

            <Border Background="#E8E1CF"
                        CornerRadius="8"
                        ClipToBounds="True">

                    <Image x:Name="imgPerfil"
                           Source="/ImagemAcelera/AvatarPadrao.png"
                           Stretch="UniformToFill"/>

                </Border>

            </Border>

                <!-- INFO -->
                <StackPanel Grid.Column="1"
                            Margin="15,0">

                    <!-- NOME -->
                    <TextBlock Text="Nome"
                               Foreground="#1F3A5F"
                               FontWeight="Bold"
                               FontSize="12"/>

                    <Border Background="#E8E1CF"
                            BorderBrush="#BDAE84"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,3,0,8"
                            Padding="8">

                        <TextBlock x:Name="txtNome"
                                   Foreground="#2B2B2B"/>
                    </Border>

                    <!-- BIO -->
                    <TextBlock Text="Biografia"
                               Foreground="#1F3A5F"
                               FontWeight="Bold"
                               FontSize="12"/>

                    <Border Background="#E8E1CF"
                            BorderBrush="#BDAE84"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,3,0,8"
                            Padding="8">

                        <TextBlock x:Name="txtBio"
                                   Height="60"
                                   TextWrapping="Wrap"
                                   Foreground="#2B2B2B"/>
                    </Border>

                    <!-- REDES -->
                    <StackPanel Orientation="Horizontal">

                        <!-- FACEBOOK -->
                        <StackPanel Margin="0,0,20,0">

                            <TextBlock Text="Facebook"
                                       Foreground="#1F3A5F"
                                       FontWeight="Bold"
                                       FontSize="12"/>

                            <Border Background="#E8E1CF"
                                    BorderBrush="#BDAE84"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Margin="0,3,0,0"
                                    Padding="6">

                                <TextBlock x:Name="txtFacebook"
                                           Width="180"
                                           Foreground="#2B2B2B"/>
                            </Border>

                        </StackPanel>

                        <!-- INSTAGRAM -->
                        <StackPanel>

                            <TextBlock Text="Instagram"
                                       Foreground="#1F3A5F"
                                       FontWeight="Bold"
                                       FontSize="12"/>

                            <Border Background="#E8E1CF"
                                    BorderBrush="#BDAE84"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Margin="0,3,0,0"
                                    Padding="6">

                                <TextBlock x:Name="txtInstagram"
                                           Width="180"
                                           Foreground="#2B2B2B"/>
                            </Border>

                        </StackPanel>

                    </StackPanel>

                </StackPanel>

            </Grid>

        </Border>

        <!-- ABAS -->
        <Grid Grid.Row="1"
              Margin="25,0,25,20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <!-- POSTS -->
                <Button x:Name="btnPosts"
                        Style="{StaticResource PerfilTabButtonStyle}"
                        Content="Publicações"
                        Width="180"
                        Height="45"
                        Click="Posts_Button"/>

                <!-- OBRAS -->
                    <Button x:Name="btnObras"
                            Style="{StaticResource PerfilTabButtonStyle}"
                            Content="Obras"
                            Width="180"
                            Height="45"
                            Click="Obras_Button"/>

                <!-- GALERIA -->
                    <Button x:Name="btnGaleria"
                            Style="{StaticResource PerfilTabButtonStyle}"
                            Content="Galeria"
                            Width="180"
                            Height="45"
                            Click="Galeria_Button"/>

            </StackPanel>

            <!-- LINHA -->
            <Border Grid.Row="1"
                    Background="#C9B27D"
                    Height="1"/>

        </Grid>

        <!-- CONTEÚDO -->
        <Border Grid.Row="2"
                Background="#F3E6C9"
                CornerRadius="20"
                BorderBrush="#C9B27D"
                BorderThickness="2"
                Margin="20,0,20,20"
                Padding="15">

            <Frame x:Name="framePerfilVisual"
                   NavigationUIVisibility="Hidden"
                   Background="Transparent"/>

        </Border>

    </Grid>

</Page>