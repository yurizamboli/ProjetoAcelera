<Window x:Class="ProjetoAcelera.Views.PopUpObras.ObrasPopUp"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalhe da Obra"
        Height="760"
        Width="620"
        ResizeMode="NoResize"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow">

    <!-- FUNDO -->
    <Window.Background>
        <ImageBrush ImageSource="/ImagemAcelera/solid-navy-blue-concrete-textured-wall.jpg"
                    Stretch="UniformToFill"/>
    </Window.Background>

    <Grid>

        <!-- CARD -->
        <Border Background="#F3E6C9"
                Margin="24"
                Padding="24"
                CornerRadius="22"
                BorderBrush="#C9B27D"
                BorderThickness="2">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <!-- IMAGEM -->
                    <Border Height="320"
                            CornerRadius="18"
                            ClipToBounds="True"
                            BorderBrush="#C9B27D"
                            BorderThickness="2"
                            Background="#DDD"
                            Margin="0,0,0,20">

                        <Grid>

                            <Image x:Name="imgCapa"
                                   Stretch="Fill"/>

                            <!-- ESTRELA FAVORITAR -->
                            <!-- ESTRELA FAVORITAR -->
                            <Button Width="48"
                                    Height="48"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="12"
                                    Background="#AA000000"
                                    BorderBrush="Transparent"
                                    Cursor="Hand"
                                    Click="BtnFavoritar_Click">

                                <TextBlock x:Name="txtEstrela"
                                           Text="☆"
                                           FontSize="24"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Button>
                        </Grid>
                    </Border>

                    <!-- TÍTULO -->
                    <TextBlock x:Name="txtTitulo"
                               FontSize="30"
                               FontWeight="Bold"
                               FontFamily="Georgia"
                               Foreground="#1F3A5F"
                               TextWrapping="Wrap"
                               Margin="0,0,0,14"/>

                    <!-- DESCRIÇÃO -->
                    <Border Background="#FFF7E1"
                            CornerRadius="14"
                            Padding="18"
                            BorderBrush="#D8C28D"
                            BorderThickness="1.5"
                            Margin="0,0,0,24">

                        <TextBlock x:Name="txtDescricao"
                                   FontSize="14"
                                   Foreground="#444444"
                                   TextWrapping="Wrap"
                                   LineHeight="24"/>

                    </Border>

                    <!-- BOTÕES -->
                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- EDITAR -->
                        <Button Grid.Column="0"
                                Content="Editar"
                                Height="46"
                                Margin="0,0,10,0"
                                FontSize="14"
                                FontWeight="Bold"
                                Background="#1F3A5F"
                                Foreground="#F3E6C9"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="BtnEditar_Click"/>

                        <!-- EXCLUIR -->
                        <Button Grid.Column="1"
                                Content="Excluir"
                                Height="46"
                                Margin="10,0,0,0"
                                FontSize="14"
                                FontWeight="Bold"
                                Background="#8B1E1E"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="BtnExcluir_Click"/>

                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>