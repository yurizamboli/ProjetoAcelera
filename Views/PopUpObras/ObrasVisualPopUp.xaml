<Window x:Class="ProjetoAcelera.Views.PopUpObras.ObrasVisualPopUp"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Obra"
        Height="760"
        Width="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow">

    <!-- FUNDO -->
    <Window.Background>
        <ImageBrush ImageSource="/ImagemAcelera/solid-navy-blue-concrete-textured-wall.jpg"
                    Stretch="UniformToFill"/>
    </Window.Background>

    <Grid>

        <!-- CARD -->
        <Border Background="#F3E6C9"
                Margin="24"
                Padding="24"
                CornerRadius="22"
                BorderBrush="#C9B27D"
                BorderThickness="2">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <!-- IMAGEM -->
                    <Border Height="360"
                            Background="#E8E1CF"
                            BorderBrush="#C9B27D"
                            BorderThickness="2"
                            CornerRadius="18"
                            ClipToBounds="True"
                            Margin="0,0,0,20">

                        <Grid>

                            <Image x:Name="imgCapa"
                                   Stretch="Fill"/>

                            <!-- ESTRELA -->
                            <Border x:Name="estrelaFavorita"
                                    Width="40"
                                    Height="40"
                                    CornerRadius="20"
                                    Background="#AA000000"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="12"
                                    Visibility="Collapsed">

                                <TextBlock Text="★"
                                           Foreground="Gold"
                                           FontSize="22"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>

                        </Grid>

                    </Border>

                    <!-- TITULO -->
                    <TextBlock x:Name="txtTitulo"
                               FontSize="30"
                               FontWeight="Bold"
                               FontFamily="Georgia"
                               Foreground="#1F3A5F"
                               TextWrapping="Wrap"
                               Margin="0,0,0,18"/>

                    <!-- DESCRIÇÃO -->
                    <Border Background="#FFF7E1"
                            BorderBrush="#D4C39A"
                            BorderThickness="1.5"
                            CornerRadius="16"
                            Padding="20"
                            MinHeight="140">

                        <TextBlock x:Name="txtDescricao"
                                   FontSize="15"
                                   Foreground="#444444"
                                   TextWrapping="Wrap"
                                   LineHeight="24"/>

                    </Border>

                    <!-- BOTÃO -->
                    <Button Content="Fechar"
                            Height="44"
                            Margin="0,22,0,0"
                            Background="#1F3A5F"
                            Foreground="#F3E6C9"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Button_Click"/>

                </StackPanel>

            </ScrollViewer>

        </Border>

    </Grid>
</Window>